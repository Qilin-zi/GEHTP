{
  "dialog": {
    "version": 1,
    "type": "lade",
    "lade": {
      "version": 1,
      "update-mode": "ALWAYS_FWD_ONE",
      "window": 8,
      "ngram": 5,
      "gcap": 8
    },
    "context": {
      "version": 1,
      "size": 2048,
      "n-vocab": 151936,
      "bos-token": -1,
      "eos-token": 151645
    },
    "sampler": {
      "version": 1,
      "seed": 42,
      "temp": 0.6,
      "top-k": 20,
      "top-p": 0.95,
      "greedy": false
    },
    "tokenizer": {
      "version": 1,
      "path": "./tokenizer.json"
    },
    "engine": {
      "version": 1,
      "n-threads": 1,
      "backend": {
        "version": 1,
        "type": "QnnHtp",
        "QnnHtp": {
          "version": 1,
          "use-mmap": false,
          "spill-fill-bufsize": 0,
          "mmap-budget": 0,
          "poll": true,
          "pos-id-dim": 64,
          "cpu-mask": "0xe0",
          "kv-dim": 128,
          "allow-async-init": false,
          "enable-graph-switching": false
        }
      },
      "model": {
        "version": 1,
        "type": "binary",
        "binary": {
          "version": 1,
          "ctx-bins": [
            "./serialized_v73/1_of_3_v73.bin",
            "./serialized_v73/2_of_3_v73.bin",
            "./serialized_v73/3_of_3_v73.bin"
          ]
        }
      }
    }
  }
}
