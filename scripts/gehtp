#!/bin/bash
# gehtp — GEHTP 用户正门: 编译 + 上板 两命令
# =====================================================================
#   gehtp compile model.onnx -o model.wtop [--vtcm-budget N] [--input-f16 f]
#   gehtp run model.wtop --input in.f16.raw --output out.f16.raw [--device 52f67807]
#   gehtp setup [--device ...]    一次性: 构建/签名/推送 内核库 + 通用 runner
#
# 设备侧约定: run_main_on_hexagon 装载器已在 /data/local/tmp/hvxhmx23;
# runner 读 job.txt(定值路径), 跑 wt_parse→wt_exec_run_io→写输出文件。
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CB="$ROOT/compiler/build_linux"
KD="$ROOT/kernels"
SDK=/4090disk2/QCtools/qairt_2.48.40.260702
PY=/4090disk2/Qwen35dev/revlibHtpPrepare/venv310/bin/python3
HEX=/local/mnt/workspace/Qualcomm/Hexagon_SDK/6.6.0.0
HT="$HEX/tools/HEXAGON_Tools/19.0.07"
SWIV=/4090disk2/QCtools/swiv_build_utility.py
DEVROOT=/data/local/tmp/hvxhmx23
GDIR="$DEVROOT/gehtp"

die() { echo "gehtp: $*" >&2; exit 1; }

cmd_compile() {
    local onnx="" out="" vtcm="" ddr="" in_f16="" net_json="" weights="" gguf="" match="" external=""
    while [ $# -gt 0 ]; do case "$1" in
        -o|--output) out="$2"; shift 2;;
        --vtcm-budget) vtcm="$2"; shift 2;;
        --ddr-budget) ddr="$2"; shift 2;;
        --input-f16) in_f16="$2"; shift 2;;
        --net-json) net_json="$2"; shift 2;;
        --weights-bin) weights="$2"; shift 2;;
        --gguf) gguf="$2"; shift 2;;
        --match) match="$2"; shift 2;;
        --external-weights) external=1; shift;;
        -*) die "unknown flag $1";;
        *) [ -z "$onnx" ] && onnx="$1" || die "unexpected arg $1"; shift;;
    esac; done
    [ -n "$out" ] || die "usage: gehtp compile model.onnx -o model.wtop [旗标]  (大模型免重复转换: --net-json X --weights-bin Y 跳 converter)"
    case "$out" in /*) ;; *) out="$(pwd)/$out";; esac
    # 逗号多输入: 逐个 realpath 再逗号重组 (单文件 realpath 整串即死, E2 坑)
    if [ -n "$in_f16" ]; then
        local _rp=() _IFS="$IFS"; IFS=','
        read -ra _parts <<< "$in_f16"; IFS="$_IFS"
        for _p in "${_parts[@]}"; do _rp+=("$(realpath "$_p")"); done
        in_f16="$(IFS=,; echo "${_rp[*]}")"
    fi
    [ -x "$CB/hnnx_compile" ] || die "compiler not built: cmake --build $CB"
    local name; name="$(basename "$out" .wtop)"
    local work="$out.work"
    mkdir -p "$work"

    if [ -n "$net_json" ]; then
        # 直通模式: 复用已有 net.json/params (大模型转换产物, 跳 qairt-converter)
        net_json="$(realpath "$net_json")"; weights="$(realpath "$weights" 2>/dev/null || true)"
        [ -f "$net_json" ] && [ -s "$weights" ] || die "--net-json/--weights-bin 需同时给且存在"
        echo "== [1-2/5] 直通: 复用 $net_json =="
        ln -sf "$net_json" "$work/${name}_net.json"
        ln -sf "$weights" "$work/model.params.bin"
    else
        [ -n "$onnx" ] || die "need model.onnx (或 --net-json 直通)"
        onnx="$(realpath "$onnx" 2>/dev/null)" || die "not found: $onnx"
        echo "== [1/5] qairt-converter (ONNX → DLC) =="
        PYTHONPATH="$SDK/lib/python" $PY "$SDK/bin/x86_64-linux-clang/qairt-converter" \
            -i "$onnx" --float_bitwidth 16 -o "$work/$name.cpp" 2>&1 | tail -1

        echo "== [2/5] dlc_repair + dlc-to-json =="
        "$ROOT/scripts/dlc_repair.sh" "$work/$name.cpp" "$work/$name.dlc"
        PYTHONPATH="$SDK/lib/python" $PY "$SDK/bin/x86_64-linux-clang/qairt-dlc-to-json" \
            -i "$work/$name.dlc" -o "$work/${name}_net.json" 2>&1 | tail -1
        unzip -p "$work/$name.cpp" model.params.bin > "$work/model.params.bin" 2>/dev/null || true
        [ -s "$work/model.params.bin" ] || die "model.params.bin missing in DLC"
    fi

    echo "== [3/5] hnnx_compile (tagged runlist) =="
    # M2/M3: 静态规划预算随编译进 TAG_MEM_PLAN; wtop_emit 只读 plan, 不再收预算旗标。
    local c_args=()
    [ -n "$ddr" ] && c_args+=(--ddr-budget "$ddr")
    [ -n "$vtcm" ] && c_args+=(--plan-vtcm-budget "$vtcm")
    # hnnx_compile 不需要 --external-weights (tagged.bin 始终内嵌权重元数据;
    # 外部化仅在 wtop_emit 阶段做槽路由 + 磁盘拆分)
    "$CB/hnnx_compile" --net-json "$work/${name}_net.json" \
        --weights-bin "$work/model.params.bin" --format tagged \
        "${c_args[@]}" \
        --output "$work/$name.tagged.bin" | tail -1

    echo "== [4/5] wtop_emit (blob) =="
    local in_args=()
    [ -n "$in_f16" ] && in_args+=(--input-f16 "$in_f16")
    if [ -n "$gguf" ]; then
        gguf="$(realpath "$gguf")"; match="$(realpath "$match" 2>/dev/null || true)"
        [ -f "$gguf" ] && [ -f "$match" ] || die "--gguf 需配 --match <tsv>"
        in_args+=(--gguf "$gguf" --match "$match")
    fi
    if [ -n "$external" ]; then
        in_args+=(--ext-weights)
    fi
    "$CB/wtop_emit" --bin "$work/$name.tagged.bin" "${in_args[@]}" \
        --out "$out" --manifest "$out.manifest.json" | tail -1

    echo "== [5/5] done =="
    echo "blob:     $out ($(wc -c < "$out") bytes)"
    echo "manifest: $out.manifest.json"
    echo "workdir:  $work (net.json / tagged.bin 等中间产物)"
}

cmd_run() {
    local blob="" input="" output="" device="${ANDROID_SERIAL:-52f67807}" trace=0
    while [ $# -gt 0 ]; do case "$1" in
        --input) input="$2"; shift 2;;
        --output) output="$2"; shift 2;;
        --device) device="$2"; shift 2;;
        --trace) trace=1; shift;;   # PROF W-P2: per-op optrace 落盘行 (调试取证; 性能测量勿开)
        -*) die "unknown flag $1";;
        *) [ -z "$blob" ] && blob="$1" || die "unexpected arg $1"; shift;;
    esac; done
    [ -n "$blob" ] && [ -n "$input" ] && [ -n "$output" ] || \
        die "usage: gehtp run model.wtop --input in.f16.raw --output out.f16.raw [--device 52f67807]"
    blob="$(realpath "$blob" 2>/dev/null)"; input="$(realpath "$input" 2>/dev/null)"
    [ -f "$blob" ] && [ -f "$input" ] || die "blob/input not found"
    case "$output" in /*) ;; *) output="$(pwd)/$output";; esac
    local manifest="$blob.manifest.json"
    [ -f "$manifest" ] || die "manifest missing: $manifest (compile 同目录产出)"
    local out_temp
    out_temp="$(python3 -c "import json;print(json.load(open('$manifest'))['output_temp'])")"

    command -v adb >/dev/null || die "adb not in PATH"
    adb -s "$device" shell "test -x $DEVROOT/run_main_on_hexagon && test -f $DEVROOT/gehtp_runner.so" 2>/dev/null \
        || die "device side not ready — run: gehtp setup --device $device"

    local bname; bname="$(basename "$blob")"
    local wgt_bname="${bname%.wtop}.weights.bin"
    echo "== push =="
    adb -s "$device" shell "mkdir -p $GDIR && rm -f $GDIR/output.f16.raw" >/dev/null
    # 大 blob 免重推: 设备侧同名尺寸一致即跳过 (1.67GB 重试省 ~3min)
    local local_size dev_size
    local_size="$(wc -c < "$blob")"
    dev_size="$(adb -s "$device" shell "wc -c < $GDIR/$bname 2>/dev/null" 2>/dev/null | tr -d '\r' || true)"
    if [ "$dev_size" = "$local_size" ]; then
        echo "  $bname 已在设备且尺寸一致, 跳过推送"
    else
        adb -s "$device" push "$blob" "$GDIR/$bname" >/dev/null
    fi
    # 路线B: 推送外部权重区
    local wgt_local_size wgt_dev_size
    # 本地权重文件名 = 剥 .wtop 后缀 + .weights.bin (与 wgt_bname 同构, 勿写成 $blob.weights.bin)
    wgt_local_size="$(wc -c < "${blob%.wtop}.weights.bin" 2>/dev/null || echo 0)"
    if [ "$wgt_local_size" -gt 0 ]; then
        wgt_dev_size="$(adb -s "$device" shell "wc -c < $GDIR/$wgt_bname 2>/dev/null" 2>/dev/null | tr -d '\r' || true)"
        if [ "$wgt_dev_size" = "$wgt_local_size" ]; then
            echo "  $wgt_bname 已在设备且尺寸一致, 跳过推送"
        else
            adb -s "$device" push "${blob%.wtop}.weights.bin" "$GDIR/$wgt_bname" >/dev/null
        fi
    fi
    adb -s "$device" push "$input" "$GDIR/input.f16.raw" >/dev/null
    if [ "$wgt_local_size" -gt 0 ]; then
        printf 'blob %s/%s\ninput %s/input.f16.raw\noutput %s/output.f16.raw\nout_temp %s\nweights_size %s\n' \
            "$GDIR" "$bname" "$GDIR" "$GDIR" "$out_temp" "$wgt_local_size" > /tmp/gehtp_job.txt
    else
        printf 'blob %s/%s\ninput %s/input.f16.raw\noutput %s/output.f16.raw\nout_temp %s\n' \
            "$GDIR" "$bname" "$GDIR" "$GDIR" "$out_temp" > /tmp/gehtp_job.txt
    fi
    # PROF W-P2: trace 旗标经 job.txt 下发 (runner 读到 =1 才开 per-op 落盘行)
    [ "$trace" = 1 ] && printf 'trace 1\n' >> /tmp/gehtp_job.txt
    adb -s "$device" push /tmp/gehtp_job.txt "$GDIR/job.txt" >/dev/null

    # PROF W-P2: prof 产物目录取 output 同侧 prof/, 键 = blob 名
    local prof_dir; prof_dir="$(dirname "$output")/prof"
    mkdir -p "$prof_dir"
    local pname="${bname%.wtop}"
    local run_log="$prof_dir/$pname.run.log"
    # trace 模式: optrace.txt 是 append 累积文件, 先清保证拉到的是本次
    [ "$trace" = 1 ] && adb -s "$device" shell "rm -f /data/local/tmp/hrt/gehtp/optrace.txt" >/dev/null

    echo "== run on $device =="
    adb -s "$device" shell "cd $DEVROOT && ADSP_LIBRARY_PATH=$DEVROOT CDSP_LIBRARY_PATH=$DEVROOT ./run_main_on_hexagon 3 gehtp_runner.so" 2>&1 | tee "$run_log" | tail -20

    echo "== pull =="
    adb -s "$device" pull "$GDIR/output.f16.raw" "$output" >/dev/null \
        || die "no output on device (runner log: $run_log)"
    echo "output: $output ($(wc -c < "$output") bytes)"
    # PROF W-P2: 性能证据三件套 (设备结果 txt / 逐 op 时间戳对 / optrace)
    adb -s "$device" pull "/data/local/tmp/hrt/gehtp/42_gehtp_runner.txt" \
        "$prof_dir/$pname.device.txt" >/dev/null 2>&1 \
        && echo "prof: $prof_dir/$pname.device.txt (含 [timing]/[run] 行)" \
        || echo "prof: 设备结果 txt 拉取失败 (非致命)"
    adb -s "$device" pull "/data/local/tmp/hrt/gehtp/op_ts.bin" \
        "$prof_dir/$pname.op_ts.bin" >/dev/null 2>&1 \
        && echo "prof: $prof_dir/$pname.op_ts.bin" \
        || echo "prof: op_ts.bin 拉取失败 (非致命)"
    if [ "$trace" = 1 ]; then
        adb -s "$device" pull "/data/local/tmp/hrt/gehtp/optrace.txt" \
            "$prof_dir/$pname.optrace.txt" >/dev/null 2>&1 \
            && echo "prof: $prof_dir/$pname.optrace.txt" \
            || echo "prof: optrace.txt 拉取失败 (trace=1 但未产出?)"
    fi
    echo "prof 报表: scripts/gehtp_prof.py --wtop $blob --op-ts $prof_dir/$pname.op_ts.bin"
}

cmd_setup() {
    local device="${ANDROID_SERIAL:-52f67807}"
    while [ $# -gt 0 ]; do case "$1" in
        --device) device="$2"; shift 2;;
        *) die "unknown arg $1";;
    esac; done
    local CC="$HT/Tools/bin/hexagon-clang"
    [ -x "$CC" ] || die "Hexagon SDK toolchain missing: $CC"

    echo "== [0/5] skel 治理 (SWIV 签名强制) =="
    # 2026-09-17 事故定案: 未签 SWIV 的 skel 上板 → 失败 open 楔死 fastrpc 通道
    # (全板 0x39, 须物理复位)。好坏件二进制本体逐字节相同, 唯一差=SWIV 段;
    # 对未签件补签 = 已知好件 md5 380f3cbf (确定性, 已实锤)。
    # 真源 = 树内 ship/ 预编译件; 缺失则从源码重建 (SDK 例程, qaic+clang)。
    local RMOH="$KD/third_party/run_main_on_hexagon"
    local skel_src="$RMOH/ship/librun_main_on_hexagon_skel.so"
    if [ ! -f "$skel_src" ]; then
        echo "  ship/ skel 缺失, 从源码重建 (make V=hexagon_ReleaseG_toolv19_v81)..."
        local bdir="/tmp/gehtp_rmoh_build.$$"
        rm -rf "$bdir"; cp -r "$RMOH" "$bdir"
        # 末尾 hexagon-sim 冒烟步缺 libncurses5 会挂, 不影响 skel 产物 — 故 || true
        ( cd "$bdir" && make V=hexagon_ReleaseG_toolv19_v81 \
            HEXAGON_SDK_ROOT="$HEX" SDK_SETUP_ENV=1 \
            HEXAGON_TOOLS_ROOT="$HT" >/dev/null 2>&1 || true )
        skel_src="$bdir/hexagon_ReleaseG_toolv19_v81/librun_main_on_hexagon_skel.so"
        [ -f "$skel_src" ] || die "skel 源码重建失败"
    fi
    local skel_push="$skel_src"
    if strings "$skel_src" | grep -q SWIV; then
        echo "  skel 已带 SWIV 段 ✓ ($(md5sum "$skel_src" | cut -c1-8))"
    else
        echo "  warn: ship/ skel 无 SWIV 段 (陈旧血统, 4090 树同款毒源) — 现场补签"
        skel_push="/tmp/librun_main_on_hexagon_skel.signed.$$.so"
        python3 "$SWIV" -i "$skel_src" -o "$skel_push" >/dev/null || die "skel SWIV 补签失败"
        echo "  补签后 md5=$(md5sum "$skel_push" | cut -c1-8) (期望 380f3cbf)"
    fi

    echo "== [1/4] kernels lib =="
    [ -f "$KD/lib/libhvxhmx_v23.signed.so" ] || (cd "$KD" && ./build_libs.sh >/dev/null)

    echo "== [2/4] generic runner (42_gehtp_runner) =="
    local INC_HEX="-I$HEX/incs -I$HEX/incs/stddef \
        -I$HEX/rtos/qurt/computev81/include -I$HEX/rtos/qurt/computev81/include/qurt"
    $CC -mv81 -O2 -mhvx -mhmx -shared -fPIC -std=gnu11 -Wall -mhvx-length=128B \
        $INC_HEX -I"$KD/include" -I"$KD/examples/common" \
        -o /tmp/gehtp_runner.so "$KD/examples/42_gehtp_runner/main.c" \
        "$KD/examples/common/example_util.c" -L"$KD/lib" -lhvxhmx_v23 -lc -ldl -lgcc
    local ng
    ng=$("$HT/Tools/bin/hexagon-llvm-objdump" -d /tmp/gehtp_runner.so | grep -c vgather || true)
    [ "$ng" = "0" ] || die "vgather 铁律违反 ($ng)"
    python3 "$SWIV" -i /tmp/gehtp_runner.so -o /tmp/gehtp_runner.so.signed 2>&1 | tail -1

    echo "== [3/4] push to $device =="
    adb -s "$device" shell "mkdir -p $GDIR" >/dev/null
    adb -s "$device" push "$KD/lib/libhvxhmx_v23.signed.so" "$DEVROOT/libhvxhmx_v23.so" >/dev/null
    adb -s "$device" push /tmp/gehtp_runner.so.signed "$DEVROOT/gehtp_runner.so" >/dev/null
    # skel: 治理后推送 + 读回 SWIV 段校验 (覆盖即治好; 旧流程盲推是毒化源头)
    adb -s "$device" push "$skel_push" "$DEVROOT/librun_main_on_hexagon_skel.so" >/dev/null
    adb -s "$device" shell "strings $DEVROOT/librun_main_on_hexagon_skel.so | grep -q SWIV" \
        || die "skel 设备侧 SWIV 段读回校验失败 (通道会楔死, 勿继续)"
    # 装载器缺失时从 ship/ 补 (旧行为: 仅报错)
    if ! adb -s "$device" shell "test -x $DEVROOT/run_main_on_hexagon" 2>/dev/null; then
        echo "  装载器缺失, 从 ship/ 补推"
        adb -s "$device" push "$RMOH/ship/run_main_on_hexagon" "$DEVROOT/run_main_on_hexagon" >/dev/null
        adb -s "$device" shell "chmod 755 $DEVROOT/run_main_on_hexagon"
    fi

    echo "== [4/4] done =="
    echo "device side ready: $DEVROOT/{libhvxhmx_v23.so, gehtp_runner.so, run_main_on_hexagon, librun_main_on_hexagon_skel.so(SWIV✓)}"
}

case "${1:-}" in
    compile) shift; cmd_compile "$@";;
    run)     shift; cmd_run "$@";;
    setup)   shift; cmd_setup "$@";;
    *) echo "usage: gehtp {compile|run|setup} ..." >&2; exit 1;;
esac
